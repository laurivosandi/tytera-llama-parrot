+/** USB PTT request state; access serialized by the USB service mutex. */
+struct usbControl {
+    uint32_t lease; ///< Last valid PTT 1 command time, milliseconds.
+    uint32_t start; ///< Start of this uninterrupted request.
+    bool requested; ///< Request awaiting/held by the FM state machine.
+    bool blocked;   ///< Hard timeout; only PTT 0 clears it.
+};
+/** Expire request on loss of playback/connection, lease or hard timeout. */
+void usbControl_tick(struct usbControl *control, uint32_t now, bool live);
+/** Handle a CTRL payload (no channel/CRC) and return a reply string.
+ * Unsupported commands leave request state unchanged. PTT 1 renews a
+ * one-second lease but never extends the 60-second hard timeout.
+ */
+const char *usbControl_command(struct usbControl *control, uint32_t now,
+                               bool live, const uint8_t *data, size_t length);
+#ifdef __cplusplus
+}
