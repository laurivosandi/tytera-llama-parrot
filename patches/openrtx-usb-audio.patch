+static uint8_t channelCount;
+static char channelStatus[160] = "CHANNEL index=-1 rx=0 tx=0 name=Radio";
+static bool channelEvents, channelDirty;
+static int32_t receiveRssi = -127;
+static volatile uint32_t lastAudio; // Written by audio OUT ISR.
+static uint8_t frame[USB_FRAME_WIRE_MAX];
+static size_t frameSize;
+static bool discard;
+static int16_t resample[481];
+static const int16_t silence[CONFIG_USB_CAPTURE_RATE / 1000] = {};
