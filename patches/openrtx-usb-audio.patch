diff --git a/openrtx/src/core/usb_audio.c b/openrtx/src/core/usb_audio.c
new file mode 100644
index 0000000..75b1e85
--- /dev/null
+++ b/openrtx/src/core/usb_audio.c
@@ -0,0 +1,100 @@
+/*
+ * SPDX-FileCopyrightText: Copyright 2026 OpenRTX Contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "core/usb_audio.h"
+#include "interfaces/usb_audio.h"
+#include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+
+enum { BLOCK_SAMPLES = 480, DMA_SAMPLES = 2 * BLOCK_SAMPLES };
+static streamId stream = -1;
+static pathId capture_path = -1;
+static int16_t *buffer;
+static bool transmitting;
+
+void usbAudioBridge_stop(void)
+{
+    usbAudio_setFmRx(false);
+    usbAudio_setCapture(false);
+    if (stream >= 0)
+        audioStream_terminate(stream);
+    if (capture_path > 0)
+        audioPath_release(capture_path);
+    stream = -1;
+    capture_path = -1;
+    free(buffer);
+    buffer = NULL;
+    transmitting = false;
+}
+
+int usbAudioBridge_startTx(pathId path)
+{
+    usbAudioBridge_stop();
+    /* Heap is DMA-accessible SRAM; static .bss is inaccessible CCM on MDx. */
+    buffer = calloc(DMA_SAMPLES, sizeof(*buffer));
+    if (buffer == NULL)
+        return -ENOMEM;
+    stream = audioStream_start(path, buffer, DMA_SAMPLES, 48000,
+                               STREAM_OUTPUT | BUF_CIRC_DOUBLE);
+    if (stream < 0) {
+        usbAudioBridge_stop();
+        return -EIO;
+    }
+    transmitting = true;
+    return 0;
+}
+
+bool usbAudioBridge_update(bool rx, bool tx)
+{
+    bool capture = rx && usbAudio_capturing();
+    if (!tx && transmitting)
+        usbAudioBridge_stop();
+    if (!capture && (capture_path > 0))
+        usbAudioBridge_stop();
+    if (capture && (stream < 0)) {
+        capture_path = audioPath_request(SOURCE_RTX, SINK_MCU, PRIO_RX);
+        if (capture_path <= 0)
+            return false;
+        buffer = calloc(DMA_SAMPLES, sizeof(*buffer));
+        if (buffer == NULL) {
+            usbAudioBridge_stop();
+            return false;
+        }
+        stream = audioStream_start(capture_path, buffer, DMA_SAMPLES, 48000,
+                                   STREAM_INPUT | BUF_CIRC_DOUBLE);
+        if (stream < 0) {
+            usbAudioBridge_stop();
+            return false;
+        }
+        usbAudio_setCapture(true);
+    }
+    if (stream < 0)
+        return false;
+    if (tx) {
+        /* Wait for a completed half, fill it, then convert it before DMA reuse. */
+        int16_t *idle = outputStream_getIdleBuffer(stream);
+        if (idle == NULL) {
+            usbAudioBridge_stop();
+            return false;
+        }
+        usbAudio_read(idle);
+        if (!outputStream_sync(stream, true)) {
+            usbAudioBridge_stop();
+            return false;
+        }
+    } else {
+        dataBlock_t block = inputStream_getData(stream);
+        if ((block.data == NULL) || (block.len != BLOCK_SAMPLES)) {
+            usbAudioBridge_stop();
+            return false;
+        }
+        /* STM32 ADC data is unsigned, right-aligned 12-bit. */
+        for (size_t i = 0; i < block.len; ++i)
+            block.data[i] = (int16_t)(((int32_t)block.data[i] - 2048) * 16);
+        usbAudio_write(block.data, block.len);
+    }
+    return true;
+}
diff --git a/openrtx/src/core/usb_control.c b/openrtx/src/core/usb_control.c
new file mode 100644
index 0000000..3406d69
--- /dev/null
+++ b/openrtx/src/core/usb_control.c
@@ -0,0 +1,39 @@
+/*
+ * SPDX-FileCopyrightText: Copyright 2026 OpenRTX Contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "core/usb_control.h"
+#include <string.h>
+
+enum { LEASE_MS = 1000, MAX_TX_MS = 60000 };
+
+void usbControl_tick(struct usbControl *control, uint32_t now, bool live)
+{
+    if (control->requested && (now - control->start >= MAX_TX_MS)) {
+        control->blocked = true;
+        control->requested = false;
+    }
+    if (!live || (now - control->lease >= LEASE_MS))
+        control->requested = false;
+}
+
+const char *usbControl_command(struct usbControl *control, uint32_t now,
+                               bool live, const uint8_t *data, size_t length)
+{
+    usbControl_tick(control, now, live);
+    if ((length == 5) && !memcmp(data, "PTT 0", 5)) {
+        control->requested = control->blocked = false;
+        return "OK";
+    }
+    if ((length == 5) && !memcmp(data, "PTT 1", 5)) {
+        if (control->blocked || !live)
+            return "ERR playback inactive or timeout; PTT 0 to reset";
+        if (!control->requested)
+            control->start = now;
+        control->lease = now;
+        control->requested = true;
+        return "OK requested";
+    }
+    return "ERR unsupported";
+}
