+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+#include <stddef.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+struct usbRx {
+    uint32_t dropped, underruns, blocks; ///< Capture diagnostic counters.
+    uint32_t last; ///< Last observed ready event, milliseconds.
+    uint8_t markers[16]; ///< Last eight bytes of each hardware half.
+    uint32_t early, ambiguous, unsynced, torn, io, full; ///< Drop reasons.
+    int next; ///< Expected half, -1 before synchronization.
+};
+/** Initialize stream state and remember RAM markers before clearing stale IRQ. */
+void usbRx_init(struct usbRx *state, const uint8_t *markers, uint32_t now);
+/** Select completed half on a data-ready event; -1 means uncertain, skip it. */
+int usbRx_select(struct usbRx *state, const uint8_t *markers, uint32_t now);
+#ifdef __cplusplus
+}
