diff --git a/platform/drivers/USB/tyt/usb_rx.c b/platform/drivers/USB/tyt/usb_rx.c
new file mode 100644
index 0000000..aa0882a
--- /dev/null
+++ b/platform/drivers/USB/tyt/usb_rx.c
@@ -0,0 +1,49 @@
+/*
+ * SPDX-FileCopyrightText: Copyright 2026 OpenRTX Contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+#include "usb_rx.h"
+#include <string.h>
+
+void usbRx_init(struct usbRx *s, const uint8_t *markers, uint32_t now)
+{
+    memset(s, 0, sizeof(*s));
+    memcpy(s->markers, markers, 16);
+    s->last = now;
+    s->next = -1;
+}
+
+int usbRx_select(struct usbRx *s, const uint8_t *markers, uint32_t now)
+{
+    uint32_t elapsed = now - s->last;
+    /* Ignore premature notifications without advancing the marker baseline.
+     * Otherwise a run of early events can keep us permanently out of sync.
+     */
+    if (elapsed < 16) {
+        ++s->early;
+        ++s->dropped;
+        return -1;
+    }
+    bool a = memcmp(s->markers, markers, 8) != 0;
+    bool b = memcmp(s->markers + 8, markers + 8, 8) != 0;
+    memcpy(s->markers, markers, 16);
+    s->last = now;
+    if (a && b) {
+        s->next = -1;
+        ++s->ambiguous;
+        ++s->dropped;
+        return -1;
+    }
+    /* A uniquely changed half re-establishes ownership after a scheduling
+     * gap. Timing alone may only choose a half while alternation is locked.
+     */
+    int half = a != b ? (b ? 1 : 0) : (elapsed <= 48 ? s->next : -1);
+    if (half < 0) {
+        s->next = -1;
+        ++s->unsynced;
+        ++s->dropped;
+        return -1;
+    }
+    s->next = 1 - half;
+    return half;
+}
