index 0170d49..0d76583 100644
--- a/platform/drivers/baseband/HR_C6000.cpp
+++ b/platform/drivers/baseband/HR_C6000.cpp
@@ -5,6 +5,7 @@
  */
 
 #include "core/utils.h"
+#include <errno.h>
 #include "drivers/baseband/HR_C6000.h"
 
 /*
@@ -77,3 +78,92 @@ void HR_C6000::sendTone(const uint32_t freq, const uint8_t deviation)
     writeCfgRegister(0x60, 0x00);         // Disable FM transmission
     writeCfgRegister(0x60, 0x80);         // Enable FM transmission, start sending the tone
 }
+
+int HR_C6000::readFmRxProbe(uint8_t chunk, uint8_t *data, uint8_t *registers)
+{
+    if (chunk >= 16 || data == nullptr || registers == nullptr)
+        return -EINVAL;
+    /* HR_C6000 updated manual, CONFIG 0x10 (mode), 0x81/0x82 (IRQ),
+     * and "RX data register" table: FM RAM 0x030..0x22f, 0x230..0x42f.
+     * https://github.com/open-ham/OpenGD77/tree/main/docs/data_sheets/C6000
+     * Read individual addresses using the existing extended SPI transaction;
+     * do not assume undocumented burst or buffer ownership semantics.
+     */
+    registers[0] = readCfgRegister(0x10);
+    /* ModulatorMode bit 7 selects FM; the lower bits are independent. */
+    constexpr uint8_t fmModeMask = 0x80;
+    if ((registers[0] & fmModeMask) == 0)
+        return -ENOTSUP;
+    registers[1] = readCfgRegister(0x81);
+    registers[2] = readCfgRegister(0x82);
+    uint16_t address = 0x030 + static_cast<uint16_t>(chunk) * 64;
+    for (size_t i = 0; i < 64; ++i)
+        data[i] = readReg16(C6000_SpiOpModes::DATA, address + i);
+    return 0;
+}
+
+void HR_C6000::readFmProbeRegisters(uint8_t *values)
+{
+    /* HR_C6000 CONFIG table: interface, mode, IRQ mask, codec control.
+     * Compare two documented address forms without modifying the chip.
+     */
+    const uint8_t addresses[] = {0x01, 0x10, 0x81, 0xe0};
+    for (size_t i = 0; i < sizeof(addresses); ++i) {
+        values[i] = readCfgRegister(addresses[i]);
+        values[i + 4] = readReg16(C6000_SpiOpModes::CONFIG, addresses[i]);
+    }
+}
+
+int HR_C6000::readFmRxRam(uint16_t offset, uint8_t *data, size_t length)
+{
+    if (data == nullptr || offset >= 1024 || !length ||
+        length > 512 || length > 1024 - offset)
+        return -EINVAL;
+    /* HR_C6000 manual 5.2: addresses auto-increment while CS stays asserted.
+     * MD-UV390 bench: extended reads work at normal SPI speed; ordinary
+     * 8-bit-address reads corrupt the first data bit at that speed.
+     */
+    uint16_t address = 0x30 + offset;
+    uint8_t command[] = {
+        SPI_FLAGS_READ | SPI_FLAGS_EXTD |
+            static_cast<uint8_t>(C6000_SpiOpModes::DATA),
+        static_cast<uint8_t>(address),
+        static_cast<uint8_t>((address >> 8) & 7)
+    };
+    ScopedChipSelect cs(uSpi, uCs);
+    int result = spi_send(uSpi, command, sizeof(command));
+    return result < 0 ? result : spi_receive(uSpi, data, length);
+}
+
+bool HR_C6000::fmRxReady()
+{
+    /* HR_C6000 manual 5.1: CONFIG 0x82 bit 1 is FM received data ready. */
+    constexpr uint8_t fmReady = 0x02;
+    return (readReg16(C6000_SpiOpModes::CONFIG, 0x82) & fmReady) != 0;
+}
+
+void HR_C6000::ackFmRxReady()
+{
+    /* CONFIG 0x83 acknowledges selected interrupt bits; leave others alone. */
+    constexpr uint8_t fmReady = 0x02;
+    writeCfgRegister(0x83, fmReady);
+}
+
+uint8_t HR_C6000::beginFmRxCapture()
+{
+    /* HR_C6000 CONFIG 0x81: a zero bit masks the corresponding event.
+     * Normal UV FM initialization enables only bit 2 (0x04).
+     * Use extended reads because fast ordinary reads corrupt bit 7 here.
+     */
+    constexpr uint8_t fmReady = 0x02;
+    uint8_t saved = readReg16(C6000_SpiOpModes::CONFIG, 0x81);
+    writeCfgRegister(0x81, saved | fmReady);
+    ackFmRxReady();
+    return saved;
+}
+
+void HR_C6000::endFmRxCapture(uint8_t mask)
+{
+    writeCfgRegister(0x81, mask);
+    ackFmRxReady();
+}
