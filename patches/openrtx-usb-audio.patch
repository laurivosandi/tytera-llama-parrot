+ * SPDX-License-Identifier: GPL-3.0-or-later
+ */
+
+#include "core/usb_frame.h"
+#include "core/crc.h"
+#include <string.h>
+
+size_t usbFrame_encode(const uint8_t *data, size_t len, uint8_t *wire,
+                       size_t capacity)
+{
+    if ((len == 0) || (len > USB_FRAME_MAX) || (capacity < len + 4))
+        return 0;
+    uint16_t crc = crc_ccitt(data, len);
+    size_t out = 1, code_pos = 0;
+    uint8_t code = 1;
+    for (size_t i = 0; i < len + 2; ++i) {
+        uint8_t value = i < len ?
+                            data[i] :
+                            (i == len ? (uint8_t)crc : (uint8_t)(crc >> 8));
+        if (value == 0) {
+            wire[code_pos] = code;
+            code_pos = out++;
+            code = 1;
+        } else {
+            wire[out++] = value;
+            ++code;
+        }
+    }
+    wire[code_pos] = code;
+    wire[out++] = 0;
+    return out;
+}
+
+size_t usbFrame_decode(const uint8_t *wire, size_t len, uint8_t *data,
+                       size_t capacity)
+{
+    if ((len < 4) || (len >= USB_FRAME_WIRE_MAX))
+        return 0;
+    uint8_t decoded[USB_FRAME_MAX + 2];
+    size_t in = 0, out = 0;
+    while (in < len) {
+        uint8_t code = wire[in++];
+        if ((code == 0) || (code - 1u > len - in))
+            return 0;
+        for (size_t i = 1; i < code; ++i) {
+            if ((out == sizeof(decoded)) || (wire[in] == 0))
+                return 0;
+            decoded[out++] = wire[in++];
+        }
+        if ((code != 255) && (in < len)) {
+            if (out == sizeof(decoded))
+                return 0;
+            decoded[out++] = 0;
+        }
+    }
+    if ((out < 3) || (out - 2 > capacity))
+        return 0;
+    size_t size = out - 2;
+    uint16_t crc = decoded[size] | ((uint16_t)decoded[size + 1] << 8);
+    if (crc != crc_ccitt(decoded, size))
+        return 0;
+    memcpy(data, decoded, size);
+    return size;
+}
