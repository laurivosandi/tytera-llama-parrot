+struct usbMixer {
+    uint32_t start; ///< Automatic transmission start tick.
+    uint8_t mode; ///< Selector pin: 1 Triggered, 2 Always.
+    bool muted; ///< Playback master mute.
+    bool requested; ///< Automatic PTT request.
+    bool blocked; ///< Requires stop, mute or mode change to rearm.
+    uint8_t squelch; ///< USB capture threshold: 0 Off, 1..15.
+    uint8_t power; ///< 0 Channel, 1..5 requested watts.
+    bool squelchOpen; ///< RSSI gate with one dB hysteresis.
+    uint8_t channelCount; ///< Number of codeplug entries exposed (max 127).
+    uint8_t channel; ///< Selector pin, 1 keeps current radio settings.
+    bool channelPending; ///< UI must consume this selection outside TX.
+};
+/** Read or write a UAC1 entity control. Returns negative errno on rejection. */
+int usbMixer_control(struct usbMixer *state, uint16_t index, uint16_t selector,
+                     uint16_t length, bool write, uint8_t *value);
+/** Update automatic PTT, including packet-loss release and 60-second limit. */
+void usbMixer_tick(struct usbMixer *state, uint32_t now, bool playing, bool live);
+/** Update the USB capture RSSI gate using OpenRTX level mapping. */
+void usbMixer_squelch(struct usbMixer *state, int32_t rssi);
+#ifdef __cplusplus
+}
