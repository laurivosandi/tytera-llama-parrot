+#ifdef CONFIG_USB_AUDIO
+/* Diagnostic transport: same pinout/clock polarity as spiC6000_func, with
+ * microsecond settling time. Shares the normal bus mutex; never used for TX.
+ */
+static uint8_t spiC6000_probe_func(const void *priv, uint8_t value)
+{
+    (void)priv;
+    uint8_t incoming = 0;
+    for (uint8_t bit = 0; bit < 8; ++bit) {
+        gpio_setPin(DMR_CLK);
+        if (value & 0x80)
+            gpio_setPin(DMR_MOSI);
+        else
+            gpio_clearPin(DMR_MOSI);
+        value <<= 1;
+        delayUs(1);
+        gpio_clearPin(DMR_CLK);
+        delayUs(1);
+        incoming = (incoming << 1) | gpio_readPin(DMR_MISO);
+    }
+    return incoming;
+}
+SPI_CUSTOM_DEVICE_DEFINE(c6000_probe_spi, spiC6000_probe_func, NULL,
+                         &c6000_mutex)
